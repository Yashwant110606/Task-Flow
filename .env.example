# ==========================================
# TaskFlow Environment Variables
# ==========================================

# MONGODB_URI: Connection string for MongoDB Atlas.
# Replace with your Atlas connection string:
# 1. Create a free cluster on mongodb.com/cloud/atlas
# 2. Under Database Access, create a user & password
# 3. Under Network Access, allow IP 0.0.0.0/0 (for deployment) or your current IP
# 4. Click "Connect" -> "Drivers" -> copy the SRV string
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/taskflow?retryWrites=true&w=majority"

# Optional: Specific database name (defaults to 'taskflow' or database in URI)
MONGODB_DB_NAME="taskflow"

# PORT: Server port (defaults to 3000)
PORT=3000

# CORS_ORIGIN: Allowed origins for API requests (comma-separated).
# Example: https://your-taskflow.vercel.app,http://localhost:5173
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# VITE_API_URL: (Frontend) Base URL for API calls.
# If deploying frontend and backend together on Render, leave empty.
# If deploying frontend on Vercel and backend on Render, set this on Vercel:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=""

# GEMINI_API_KEY (Optional for AI Studio)
GEMINI_API_KEY=""
